// Everyours data model.
// Kept deliberately small: properties, their images, and the leads they produce.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum RoadAccess {
  PAVED
  GRAVEL
  DIRT
}

enum Terrain {
  FLAT
  GENTLE_SLOPE
  HILLSIDE
}

enum Utility {
  ELECTRICITY
  WATER
  INTERNET
  SEWER
}

enum ContactMethod {
  WHATSAPP
  PHONE
  EMAIL
}

enum BudgetRange {
  UNDER_150
  FROM_150_TO_250
  FROM_250_TO_400
  OVER_400
  NOT_SURE
}
