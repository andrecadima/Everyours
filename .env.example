# ─── Database ────────────────────────────────────────────────────────────────
# Local Postgres from docker-compose.yml (host port 5433 avoids clashing with a
# Postgres you may already run on 5432).
DATABASE_URL="postgresql://everyours:everyours@localhost:5433/everyours?schema=public"

# ─── Map (optional) ──────────────────────────────────────────────────────────
# MapLibre style URL. Defaults to OpenFreeMap (free, no key, OpenStreetMap data).
# To use MapTiler, Stadia, or another provider, paste a style URL that includes
# its *public, domain-restricted* key. Never put secret keys here: every
# NEXT_PUBLIC_ variable is shipped to the browser.
NEXT_PUBLIC_MAP_STYLE_URL=""

# ─── Bot protection (optional) ───────────────────────────────────────────────
# Cloudflare Turnstile. Leave both empty to rely on the built-in honeypot +
# rate limiting. When set, the lead form renders the widget and the server
# verifies every submission.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── Internal tools ──────────────────────────────────────────────────────────
# /admin/leads is DEVELOPMENT ONLY and has no authentication. It is disabled in
# production unless this is set to "true" (do not do that without adding auth).
ENABLE_DEV_ADMIN="false"
